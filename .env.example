# Echoes After Dark Configuration
# Hacktoberfest 2026: Ghost in the Machine

# Port for the Express web server (Default: 3000)
PORT=3000

# URL of your local Ollama instance (Default: http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434

# Open-weight local AI model (Default: gemma3:1b)
# Compatible alternatives: gemma4:latest, qwen2.5-coder:3b, mistral, llama3.2:1b
OLLAMA_MODEL=gemma3:1b
